#: frappe_psak_id/psak_id/doctype/psak_id_financial_statement/psak_id_financial_statement.py:345
#, python-brace-format
msgid "A {0} statement covers {1} whole months: from the first day of a month to the last day of its last month. Starting {2}, it ends {3}."
msgstr "Laporan {0} mencakup {1} bulan penuh: dari tanggal pertama suatu bulan sampai tanggal terakhir bulan terakhirnya. Mulai {2}, laporan berakhir {3}."

#: frappe_psak_id/psak_id/report/psak_id_mapping_control/psak_id_mapping_control.py:134
